{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ResearchProcessing": {
    "Enabled": true,
    "IdleDelayMilliseconds": 1000
  },
  "AI": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1/",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 2000
  },
  "EvidenceExtraction": {
    "MaxStudiesPerRun": 10
  },
  "EvidenceEvaluation": {
    "MaxStudiesPerRun": 10
  },
  "PubMed": {
    "BaseUrl": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/",
    "ResultLimit": 10,
    "TimeoutSeconds": 15,
    "Tool": "MedResearch",
    "RequestIntervalMilliseconds": 350
  },
  "AllowedHosts": "*"
}
