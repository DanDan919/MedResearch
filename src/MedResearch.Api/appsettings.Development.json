{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MedResearch": "Host=localhost;Port=5432;Database=medresearch;Username=medresearch;Password=medresearch_dev_password"
  },
  "ResearchProcessing": {
    "Enabled": true,
    "IdleDelayMilliseconds": 1000,
    "LeaseDurationSeconds": 900,
    "HeartbeatIntervalSeconds": 60
  },
  "AI": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1/",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 2000
  },
  "PubMed": {
    "BaseUrl": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/",
    "MaxResultsPerQuery": 10,
    "TimeoutSeconds": 15,
    "Tool": "MedResearch",
    "MaxRequestsPerSecond": 2,
    "FetchBatchSize": 25,
    "MaxRetryAttempts": 2,
    "RetryBaseDelayMilliseconds": 250
  },
  "EuropePmc": {
    "Enabled": true,
    "BaseUrl": "https://www.ebi.ac.uk/europepmc/webservices/rest/",
    "MaxResultsPerQuery": 10,
    "PageSize": 25,
    "TimeoutSeconds": 15,
    "MaxRequestsPerSecond": 2,
    "MaxRetryAttempts": 2,
    "RetryBaseDelayMilliseconds": 250
  }
}
