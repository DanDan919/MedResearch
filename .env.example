# Development-only defaults. Do not use these values for production.
POSTGRES_DB=medresearch
POSTGRES_USER=medresearch
POSTGRES_PASSWORD=medresearch_dev_password
POSTGRES_PORT=5432
API_PORT=8080

# Local-only API identity. Production must use Authentication__Mode=JwtBearer
# with a trusted issuer Authority and Audience; never commit those credentials.
AUTHENTICATION_MODE=DevelopmentLocal
AUTHENTICATION_DEVELOPMENT_SUBJECT=local-development-user
AUTHENTICATION_AUTHORITY=
AUTHENTICATION_AUDIENCE=

# Next.js server environment (load separately; Compose currently starts API/PostgreSQL only).
# DevelopmentLocal is accepted by web only when NODE_ENV=development.
WEB_AUTH_MODE=DevelopmentLocal
WEB_AUTH_ORIGIN=http://127.0.0.1:3000
MEDRESEARCH_API_INTERNAL_URL=http://localhost:8080
# Production: WEB_AUTH_MODE=Oidc, HTTPS WEB_AUTH_ORIGIN, real OIDC registration below.
# Do not commit real client or session secrets. No placeholder is accepted as production configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_API_AUDIENCE=
OIDC_SCOPE=
# Optional RFC 8707 resource or provider-specific authorization audience, only if provider supports it.
OIDC_RESOURCE=
OIDC_AUTHORIZATION_AUDIENCE=
WEB_SESSION_SECRET=
WEB_SESSION_MAX_AGE_SECONDS=3600
WEB_AUTH_TIMEOUT_SECONDS=10

# OpenAI structured planning configuration.
# Do not commit real secrets in .env.
OPENAI_MODEL=
OPENAI_API_KEY=

# Optional development/manual provider. Keep AI__Provider=OpenAI by default.
# Codex CLI uses its own Codex/ChatGPT login and is never allowed in Production.
AI__Provider=OpenAI
AI__CODEXCLI__EXECUTABLEPATH=codex
AI__CODEXCLI__TIMEOUTSECONDS=300
AI__CODEXCLI__MAXPROMPTCHARACTERS=500000
AI__CODEXCLI__SANDBOX=read-only
# Bounded semantic repair after deterministic validation. 0 disables repair; max is 2.
AI__VALIDATIONGUIDEDREPAIR__MAXSEMANTICREPAIRATTEMPTS=1

# Optional NCBI/PubMed E-utilities identification and quota configuration.
PUBMED_ENABLED=true
PUBMED_EMAIL=
PUBMED_API_KEY=
PUBMED_MAX_RESULTS_PER_QUERY=10
PUBMED_MAX_REQUESTS_PER_SECOND=2
PUBMED_FETCH_BATCH_SIZE=25
PUBMED_MAX_RETRY_ATTEMPTS=2
PUBMED_RETRY_BASE_DELAY_MILLISECONDS=250
PUBMED_MAX_SEARCH_RESPONSE_BYTES=256000
PUBMED_MAX_FETCH_RESPONSE_BYTES=2000000
PUBMED_BODY_READ_TIMEOUT_SECONDS=15

# Optional Europe PMC REST search configuration. No API key is required.
EUROPEPMC_ENABLED=true
EUROPEPMC_MAX_RESULTS_PER_QUERY=10
EUROPEPMC_PAGE_SIZE=25
EUROPEPMC_MAX_REQUESTS_PER_SECOND=2
EUROPEPMC_MAX_RETRY_ATTEMPTS=2
EUROPEPMC_RETRY_BASE_DELAY_MILLISECONDS=250
EUROPEPMC_MAX_RESPONSE_BYTES=2000000
EUROPEPMC_BODY_READ_TIMEOUT_SECONDS=15

# Source material acquisition. Europe PMC full-text retrieval is PMCID-gated and bounded.
SOURCE_ACQUISITION_ENABLED=true
SOURCE_ACQUISITION_MAX_STUDIES_PER_RUN=10
SOURCE_ACQUISITION_MAX_CONTENT_CHARACTERS=30000
SOURCE_ACQUISITION_PREFER_STRUCTURED_FULL_TEXT=true
EUROPEPMC_FULLTEXT_ENABLED=true
EUROPEPMC_FULLTEXT_MAX_CONTENT_CHARACTERS=30000
EUROPEPMC_FULLTEXT_MAX_RETRY_ATTEMPTS=2
EUROPEPMC_FULLTEXT_RETRY_BASE_DELAY_MILLISECONDS=250
# Background worker processing lease.
# Pilot admission policy. Restart all API replicas after changes; this is not a money budget.
RESEARCH_ADMISSION_OWNER_OUTSTANDING_LIMIT=1
RESEARCH_ADMISSION_GLOBAL_OUTSTANDING_LIMIT=2
RESEARCH_ADMISSION_OWNER_DAILY_LIMIT=2
RESEARCH_ADMISSION_GLOBAL_DAILY_LIMIT=10
RESEARCH_ADMISSION_STOP_NEW_ADMISSIONS=false

RESEARCH_PROCESSING_LEASE_DURATION_SECONDS=900
RESEARCH_PROCESSING_HEARTBEAT_INTERVAL_SECONDS=60

# Evidence extraction background processing limit.
EVIDENCE_EXTRACTION_MAX_STUDIES_PER_RUN=10
EVIDENCE_EVALUATION_MAX_STUDIES_PER_RUN=10

# Evidence synthesis context bounds.
SYNTHESIS_MAX_STUDIES=10
SYNTHESIS_MAX_EVIDENCE_FINDINGS=40
SYNTHESIS_MAX_CLAIMS=12

# Deterministic fixed-effect quantitative synthesis V1.
QUANTITATIVE_SYNTHESIS_OUTPUT_CONFIDENCE_LEVEL=0.95
QUANTITATIVE_SYNTHESIS_MINIMUM_UNIQUE_STUDIES=2
