{
  "openapi": "3.1.0",
  "info": {
    "title": "MedResearch API",
    "version": "f1"
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "responses": {
          "200": {
            "description": "Application process is alive"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "description": "Application is ready and can reach PostgreSQL"
          },
          "503": {
            "description": "Application is not ready"
          }
        }
      }
    },
    "/api/research": {
      "get": {
        "operationId": "listResearchRuns",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ResearchRunStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged research run history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchRunListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "operationId": "createResearch",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResearchRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Research run queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/research/{researchRunId}": {
      "get": {
        "operationId": "getResearch",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "researchRunId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Research run state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchRunResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/research/{researchRunId}/progress": {
      "get": {
        "operationId": "getResearchProgress",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "researchRunId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted research run progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchRunProgressResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/research/{researchRunId}/report": {
      "get": {
        "operationId": "getResearchReport",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "researchRunId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted research report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchReportResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/research/{researchRunId}/quantitative": {
      "get": {
        "operationId": "getQuantitativeSynthesisArtifacts",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "researchRunId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted deterministic quantitative synthesis artifacts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/QuantitativeSynthesisArtifactResponse" }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "Problem": {
        "description": "Problem Details",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          },
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateResearchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": ["string", "null"]
          }
        }
      },
      "CreateResearchResponse": {
        "type": "object",
        "required": ["researchRunId", "status"],
        "additionalProperties": false,
        "properties": {
          "researchRunId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/ResearchRunStatus"
          }
        }
      },
      "ResearchRunResponse": {
        "type": "object",
        "required": ["researchRunId", "question", "status", "createdAt", "startedAt", "completedAt", "failureReason"],
        "additionalProperties": false,
        "properties": {
          "researchRunId": {
            "type": "string",
            "format": "uuid"
          },
          "question": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ResearchRunStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "completedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "failureReason": {
            "type": ["string", "null"]
          }
        }
      },
      "ResearchRunSummaryResponse": {
        "type": "object",
        "required": ["researchRunId", "researchQuestionId", "question", "status", "createdAt", "startedAt", "completedAt", "failureReason"],
        "additionalProperties": false,
        "properties": {
          "researchRunId": {
            "type": "string",
            "format": "uuid"
          },
          "researchQuestionId": {
            "type": "string",
            "format": "uuid"
          },
          "question": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ResearchRunStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "completedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "failureReason": {
            "type": ["string", "null"]
          }
        }
      },
      "ResearchRunListResponse": {
        "type": "object",
        "required": ["items", "page", "pageSize", "totalCount", "totalPages"],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResearchRunSummaryResponse"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalCount": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "ResearchRunStatus": {
        "type": "string",
        "enum": ["Queued", "Planning", "Searching", "Extracting", "Evaluating", "Synthesizing", "Completed", "Failed", "Cancelled"]
      },
      "ResearchRunProgressResponse": {
        "type": "object",
        "required": [
          "researchRunId",
          "question",
          "status",
          "createdAt",
          "startedAt",
          "completedAt",
          "failureReason",
          "refreshedAt",
          "processing",
          "metrics",
          "stages"
        ],
        "additionalProperties": false,
        "properties": {
          "researchRunId": { "type": "string", "format": "uuid" },
          "question": { "type": "string" },
          "status": { "$ref": "#/components/schemas/ResearchRunStatus" },
          "createdAt": { "type": "string", "format": "date-time" },
          "startedAt": { "type": ["string", "null"], "format": "date-time" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" },
          "failureReason": { "type": ["string", "null"] },
          "refreshedAt": { "type": "string", "format": "date-time" },
          "processing": { "$ref": "#/components/schemas/ResearchRunProcessingProgressResponse" },
          "metrics": { "$ref": "#/components/schemas/ResearchRunProgressMetricsResponse" },
          "stages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ResearchRunStageProgressResponse" }
          }
        }
      },
      "ResearchRunProcessingProgressResponse": {
        "type": "object",
        "required": ["leaseState", "leaseExpiresAt", "lastHeartbeatAt", "leaseVersion"],
        "additionalProperties": false,
        "properties": {
          "leaseState": {
            "type": "string",
            "enum": ["None", "Active", "Expired", "Terminal"]
          },
          "leaseExpiresAt": { "type": ["string", "null"], "format": "date-time" },
          "lastHeartbeatAt": { "type": ["string", "null"], "format": "date-time" },
          "leaseVersion": { "type": "integer", "format": "int64" }
        }
      },
      "ResearchRunProgressMetricsResponse": {
        "type": "object",
        "required": [
          "researchPlanCount",
          "plannedSearchQueryCount",
          "literatureSearchCount",
          "literatureSearchSourceCount",
          "literatureSearchResultCount",
          "discoveryPathCount",
          "distinctDiscoveredStudyCount",
          "currentSourceMaterialCount",
          "structuredFullTextMaterialCount",
          "abstractMaterialCount",
          "evidenceExtractionCount",
          "completedEvidenceExtractionCount",
          "skippedEvidenceExtractionCount",
          "evidenceFindingCount",
          "evidenceEvaluationCount",
          "completedEvidenceEvaluationCount",
          "skippedEvidenceEvaluationCount",
          "researchReportCount",
          "researchReportClaimCount"
        ],
        "additionalProperties": false,
        "properties": {
          "researchPlanCount": { "type": "integer" },
          "plannedSearchQueryCount": { "type": "integer" },
          "literatureSearchCount": { "type": "integer" },
          "literatureSearchSourceCount": { "type": "integer" },
          "literatureSearchResultCount": { "type": "integer" },
          "discoveryPathCount": { "type": "integer" },
          "distinctDiscoveredStudyCount": { "type": "integer" },
          "currentSourceMaterialCount": { "type": "integer" },
          "structuredFullTextMaterialCount": { "type": "integer" },
          "abstractMaterialCount": { "type": "integer" },
          "evidenceExtractionCount": { "type": "integer" },
          "completedEvidenceExtractionCount": { "type": "integer" },
          "skippedEvidenceExtractionCount": { "type": "integer" },
          "evidenceFindingCount": { "type": "integer" },
          "evidenceEvaluationCount": { "type": "integer" },
          "completedEvidenceEvaluationCount": { "type": "integer" },
          "skippedEvidenceEvaluationCount": { "type": "integer" },
          "researchReportCount": { "type": "integer" },
          "researchReportClaimCount": { "type": "integer" }
        }
      },
      "ResearchRunStageProgressResponse": {
        "type": "object",
        "required": ["stage", "state", "metrics"],
        "additionalProperties": false,
        "properties": {
          "stage": { "$ref": "#/components/schemas/ResearchRunStatus" },
          "state": {
            "type": "string",
            "enum": ["Pending", "Current", "Completed"]
          },
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ResearchRunProgressMetricResponse" }
          }
        }
      },
      "ResearchRunProgressMetricResponse": {
        "type": "object",
        "required": ["label", "value"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "integer" }
        }
      },
      "ResearchReportResponse": {
        "type": "object",
        "required": [
          "researchRunId",
          "researchReportId",
          "status",
          "insufficientEvidenceReason",
          "question",
          "executiveSummary",
          "evidenceSummary",
          "conflictSummary",
          "limitationsSummary",
          "conclusion",
          "synthesisConfidence",
          "promptVersion",
          "generatedAt",
          "coverage",
          "deterministicLimitations",
          "claims"
        ],
        "additionalProperties": false,
        "properties": {
          "researchRunId": { "type": "string", "format": "uuid" },
          "researchReportId": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "insufficientEvidenceReason": { "type": ["string", "null"] },
          "question": { "type": "string" },
          "executiveSummary": { "type": "string" },
          "evidenceSummary": { "type": "string" },
          "conflictSummary": { "type": "string" },
          "limitationsSummary": { "type": "string" },
          "conclusion": { "type": "string" },
          "synthesisConfidence": { "type": "string" },
          "promptVersion": { "type": "string" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "coverage": { "$ref": "#/components/schemas/ResearchReportCoverageResponse" },
          "deterministicLimitations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "claims": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ResearchReportClaimResponse" }
          }
        }
      },
      "ResearchReportCoverageResponse": {
        "type": "object",
        "required": [
          "discoveredStudyCount",
          "extractedStudyCount",
          "evaluatedStudyCount",
          "evidenceFindingCount",
          "includedStudyCount",
          "includedEvidenceFindingCount",
          "searchQueryCount",
          "studiesWithNoExtractableEvidence",
          "studiesWithInsufficientEvaluationSource",
          "potentialConflictDetected",
          "evidenceTruncated",
          "usesAbstractLevelEvidenceOnly",
          "searchedSources"
        ],
        "additionalProperties": false,
        "properties": {
          "discoveredStudyCount": { "type": "integer" },
          "extractedStudyCount": { "type": "integer" },
          "evaluatedStudyCount": { "type": "integer" },
          "evidenceFindingCount": { "type": "integer" },
          "includedStudyCount": { "type": "integer" },
          "includedEvidenceFindingCount": { "type": "integer" },
          "searchQueryCount": { "type": "integer" },
          "studiesWithNoExtractableEvidence": { "type": "integer" },
          "studiesWithInsufficientEvaluationSource": { "type": "integer" },
          "potentialConflictDetected": { "type": "boolean" },
          "evidenceTruncated": { "type": "boolean" },
          "usesAbstractLevelEvidenceOnly": { "type": "boolean" },
          "searchedSources": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "ResearchReportClaimResponse": {
        "type": "object",
        "required": ["claimId", "claimType", "direction", "text", "ordinal", "citations"],
        "additionalProperties": false,
        "properties": {
          "claimId": { "type": "string", "format": "uuid" },
          "claimType": { "type": "string" },
          "direction": { "type": "string" },
          "text": { "type": "string" },
          "ordinal": { "type": "integer" },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ResearchReportCitationResponse" }
          }
        }
      },
      "ResearchReportCitationResponse": {
        "type": "object",
        "required": ["evidenceId", "studyId", "pmid", "pmcid", "doi", "title", "journal", "publicationYear", "publicationMonth", "publicationDay", "publicationTypes", "authors", "studySource", "outcome", "resultSummary", "supportingText", "evidenceDirection", "sourceScope", "groundingValidated", "population", "exposureOrIntervention", "comparator", "studyDesign", "sampleSize", "effectMeasure", "effectValue", "confidenceIntervalLower", "confidenceIntervalUpper", "confidenceLevel", "reportedStandardError", "pValue", "extractedAt", "sourceMaterial", "ordinal"],
        "additionalProperties": false,
        "properties": {
          "evidenceId": { "type": "string", "format": "uuid" },
          "studyId": { "type": "string", "format": "uuid" },
          "pmid": { "type": ["string", "null"] },
          "pmcid": { "type": ["string", "null"] },
          "doi": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "journal": { "type": ["string", "null"] },
          "publicationYear": { "type": ["integer", "null"] },
          "publicationMonth": { "type": ["integer", "null"] },
          "publicationDay": { "type": ["integer", "null"] },
          "publicationTypes": { "type": "array", "items": { "type": "string" } },
          "authors": { "type": "array", "items": { "type": "string" } },
          "studySource": { "type": ["string", "null"] },
          "outcome": { "type": "string" },
          "resultSummary": { "type": ["string", "null"] },
          "supportingText": { "type": "string" },
          "evidenceDirection": { "type": "string" },
          "sourceScope": { "type": "string" },
          "groundingValidated": { "type": "boolean" },
          "population": { "type": ["string", "null"] },
          "exposureOrIntervention": { "type": ["string", "null"] },
          "comparator": { "type": ["string", "null"] },
          "studyDesign": { "type": ["string", "null"] },
          "sampleSize": { "type": ["integer", "null"] },
          "effectMeasure": { "type": ["string", "null"] },
          "effectValue": { "type": ["number", "null"] },
          "confidenceIntervalLower": { "type": ["number", "null"] },
          "confidenceIntervalUpper": { "type": ["number", "null"] },
          "confidenceLevel": { "type": ["number", "null"] },
          "reportedStandardError": { "type": ["number", "null"] },
          "pValue": { "type": ["number", "null"] },
          "extractedAt": { "type": "string", "format": "date-time" },
          "sourceMaterial": { "anyOf": [{ "$ref": "#/components/schemas/ResearchReportSourceMaterialResponse" }, { "type": "null" }] },
          "ordinal": { "type": "integer" }
        }
      },
      "ResearchReportSourceMaterialResponse": {
        "type": "object",
        "required": ["sourceMaterialId", "type", "provider", "retrievalMethod", "contentVersion", "retrievedAt", "accessStatus", "wasTruncated", "sectionNames"],
        "additionalProperties": false,
        "properties": {
          "sourceMaterialId": { "type": "string", "format": "uuid" },
          "type": { "type": "string" },
          "provider": { "type": "string" },
          "retrievalMethod": { "type": "string" },
          "contentVersion": { "type": "integer" },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "accessStatus": { "type": "string" },
          "wasTruncated": { "type": "boolean" },
          "sectionNames": { "type": "array", "items": { "type": "string" } }
        }
      },
      "QuantitativeSynthesisArtifactResponse": {
        "type": "object",
        "required": ["artifactId", "persistedAt", "snapshotFingerprint", "result"],
        "additionalProperties": false,
        "properties": {
          "artifactId": { "type": "string", "format": "uuid" },
          "persistedAt": { "type": "string", "format": "date-time" },
          "snapshotFingerprint": { "type": "string" },
          "result": { "$ref": "#/components/schemas/QuantitativeSynthesisResult" }
        }
      },
      "QuantitativeSynthesisResult": {
        "type": "object",
        "required": ["researchRunId", "groupKey", "outcomeGroupKey", "populationCompatibilityKey", "comparatorCompatibilityKey", "studyDesignCompatibilityKey", "effectMeasureType", "status", "method", "algorithmVersion", "outputConfidenceLevel", "evidenceCount", "uniqueStudyCount", "analysisScaleEffect", "analysisScaleVariance", "analysisScaleStandardError", "analysisScaleConfidenceIntervalLower", "analysisScaleConfidenceIntervalUpper", "reportedScaleEffect", "reportedScaleConfidenceIntervalLower", "reportedScaleConfidenceIntervalUpper", "heterogeneityDiagnostics", "betweenStudyVariance", "randomEffects", "contributions", "rejectionReasons"],
        "additionalProperties": false,
        "properties": {
          "researchRunId": { "type": "string", "format": "uuid" },
          "groupKey": { "type": "string" },
          "outcomeGroupKey": { "type": "string" },
          "populationCompatibilityKey": { "type": "string" },
          "comparatorCompatibilityKey": { "type": "string" },
          "studyDesignCompatibilityKey": { "type": "string" },
          "effectMeasureType": { "type": "integer" },
          "status": { "type": "integer" },
          "method": { "type": "integer" },
          "algorithmVersion": { "type": "string" },
          "outputConfidenceLevel": { "type": "number" },
          "evidenceCount": { "type": "integer" },
          "uniqueStudyCount": { "type": "integer" },
          "analysisScaleEffect": { "type": ["number", "null"] },
          "analysisScaleVariance": { "type": ["number", "null"] },
          "analysisScaleStandardError": { "type": ["number", "null"] },
          "analysisScaleConfidenceIntervalLower": { "type": ["number", "null"] },
          "analysisScaleConfidenceIntervalUpper": { "type": ["number", "null"] },
          "reportedScaleEffect": { "type": ["number", "null"] },
          "reportedScaleConfidenceIntervalLower": { "type": ["number", "null"] },
          "reportedScaleConfidenceIntervalUpper": { "type": ["number", "null"] },
          "heterogeneityDiagnostics": { "oneOf": [{ "$ref": "#/components/schemas/QuantitativeHeterogeneityDiagnostics" }, { "type": "null" }] },
          "betweenStudyVariance": { "oneOf": [{ "$ref": "#/components/schemas/BetweenStudyVarianceEstimate" }, { "type": "null" }] },
          "randomEffects": { "oneOf": [{ "$ref": "#/components/schemas/QuantitativeRandomEffectsSynthesisResult" }, { "type": "null" }] },
          "contributions": { "type": "array", "items": { "$ref": "#/components/schemas/QuantitativeSynthesisContribution" } },
          "rejectionReasons": { "type": "array", "items": { "type": "integer" } }
        }
      },
      "QuantitativeHeterogeneityDiagnostics": {
        "type": "object",
        "required": ["cochransQ", "degreesOfFreedom", "iSquared", "studyCount", "algorithmVersion"],
        "additionalProperties": false,
        "properties": {
          "cochransQ": { "type": "number" },
          "degreesOfFreedom": { "type": "integer" },
          "iSquared": { "type": "number" },
          "studyCount": { "type": "integer" },
          "algorithmVersion": { "type": "string" }
        }
      },
      "BetweenStudyVarianceEstimate": {
        "type": "object",
        "required": ["tauSquared", "estimator", "status", "algorithmVersion", "studyCount", "converged", "iterationCount", "failureReason"],
        "additionalProperties": false,
        "properties": {
          "tauSquared": { "type": ["number", "null"] },
          "estimator": { "type": "integer" },
          "status": { "type": "integer" },
          "algorithmVersion": { "type": "string" },
          "studyCount": { "type": "integer" },
          "converged": { "type": "boolean" },
          "iterationCount": { "type": "integer" },
          "failureReason": { "type": ["integer", "null"] }
        }
      },
      "QuantitativeRandomEffectsSynthesisResult": {
        "type": "object",
